#include "resource.h"
#include <winver.h>

IDI_APP ICON "app.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION NR_VERSION_MAJOR,NR_VERSION_MINOR,NR_VERSION_PATCH,0
 PRODUCTVERSION NR_VERSION_MAJOR,NR_VERSION_MINOR,NR_VERSION_PATCH,0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "080404b0"
    BEGIN
      VALUE "FileDescription", "Neural Reflex"
      VALUE "ProductName", "Neural Reflex"
      VALUE "FileVersion", NR_VERSION_TEXT
      VALUE "ProductVersion", NR_VERSION_TEXT
      VALUE "OriginalFilename", "NeuralReflex.exe"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0804, 1200
  END
END
